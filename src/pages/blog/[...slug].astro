---
import Base from '../../layouts/Base.astro';
import Masthead from '../../components/Masthead.astro';
import { render } from 'astro:content';
import { getVisiblePosts, formatDate, type Post } from '../../lib/blog';

// Only visible posts get a route, so production builds emit no draft URLs.
export async function getStaticPaths() {
  const posts = await getVisiblePosts();
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props as { post: Post };
const { Content, headings } = await render(post);

// A table of contents appears only for structurally long notes: this many
// second-level sections or more. Shorter notes keep the bare article layout.
// Headings come from Astro's renderer, so the links reuse the existing heading
// IDs and no frontmatter is needed.
const TOC_MIN_H2 = 4;
const sections = headings.filter((h) => h.depth === 2);
const showToc = sections.length >= TOC_MIN_H2;
const { title, date, description, draft, archived, aiAssistance } = post.data;
---

<Base title={`${title} — Sean Davis`} description={description}>
  <Fragment slot="head">
    {draft && <meta name="robots" content="noindex" />}
    {aiAssistance && <meta name="ai-assistance" content={aiAssistance} />}
  </Fragment>
  <div class="page">
    <Masthead />

    <article class="prose">
      {draft && <p class="draft-banner">Draft — not published</p>}
      <h1>{title}</h1>
      <div class="post-date">
        {formatDate(date)}
        {archived && (
          <span class="archive-note"> · Written in {date.getUTCFullYear()}; some details may be dated.</span>
        )}
      </div>
      {description && <p class="dek">{description}</p>}
      {showToc && (
        <nav class="toc" aria-label="Contents">
          <p class="toc-title">Contents</p>
          <ol>
            {sections.map((h) => (
              <li><a href={`#${h.slug}`}>{h.text}</a></li>
            ))}
          </ol>
        </nav>
      )}
      <Content />
      <p class="back" style="margin-top:2.5rem;"><a href="/blog">← All notes</a></p>
    </article>
  </div>
</Base>
