---
import Base from '../../layouts/Base.astro';
import Masthead from '../../components/Masthead.astro';
import PostList from '../../components/PostList.astro';
import { getVisiblePosts } from '../../lib/blog';

// Newest first; archived posts get their own section below the current ones.
const posts = await getVisiblePosts();
const current = posts.filter((p) => !p.data.archived);
const archived = posts.filter((p) => p.data.archived);
---

<Base title="Notes — Sean Davis" description="Notes from Sean Davis on tools, data, and methods.">
  <div class="page">
    <Masthead />

    <section style="border-bottom: none;">
      <div class="sec-head">
        <h2>Notes</h2>
        <div class="note">Release notes, build logs, and short technical pieces.</div>
      </div>
      {posts.length === 0 && <p style="color:var(--muted)">No posts yet.</p>}
      {current.length > 0 && <PostList posts={current} />}
      {archived.length > 0 && (
        <div class="archive">
          <div class="sec-head">
            <h2>Archive</h2>
            <div class="note">Older posts, kept for the record. Some details may be dated.</div>
          </div>
          <PostList posts={archived} />
        </div>
      )}
      <p class="back" style="margin-top:2rem;"><a href="/">← Back to home</a></p>
    </section>
  </div>
</Base>
