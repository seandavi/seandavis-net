---
import Base from '../../layouts/Base.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog'))
  .filter((p) => !p.data.draft)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

const fmt = (d: Date) =>
  d.toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' });
---

<Base title="Notes — Sean Davis" description="Notes from Sean Davis on tools, data, and methods.">
  <div class="page">
    <header class="masthead">
      <a class="mark" href="/">Sean Davis</a>
      <nav>
        <a href="/#work">Work</a>
        <a href="/#software">Software</a>
        <a href="/#writing">Writing</a>
        <a href="/talks">Talks</a>
        <a href="/blog">Notes</a>
        <a href="/#about">About</a>
      </nav>
    </header>

    <section style="border-bottom: none;">
      <div class="sec-head">
        <h2>Notes</h2>
        <div class="note">Release notes, build logs, and short technical pieces.</div>
      </div>
      {posts.length === 0 ? (
        <p style="color:var(--muted)">No posts yet.</p>
      ) : (
        <div class="writing">
          {posts.map((p) => (
            <div class="wrow">
              <span class="wkind">{fmt(p.data.date)}</span>
              <div>
                <p class="wtitle"><a href={`/blog/${p.id}/`}>{p.data.title}</a></p>
                {p.data.description && <p>{p.data.description}</p>}
              </div>
            </div>
          ))}
        </div>
      )}
      <p class="back" style="margin-top:2rem;"><a href="/">← Back to home</a></p>
    </section>
  </div>
</Base>
