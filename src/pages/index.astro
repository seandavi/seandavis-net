---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Masthead from '../components/Masthead.astro';
// Head-and-shoulders crop of the press-kit portrait (src/assets/sean-davis.jpg).
import headshot from '../assets/sean-davis-hero.jpg';
import { cvDate, grants, ORCID_URL } from '../lib/cv';
import { liveProjects, homepageProjects, metaLine } from '../lib/projects';

// Same data the /projects directory renders; the homepage shows only the
// entries that carry a `homepage` rank, flagship ones as the list and the rest
// as a short card grid.
const onHome = homepageProjects(await liveProjects());
const featured = onHome.filter((p) => p.data.group === 'flagship');
const others = onHome.filter((p) => p.data.group !== 'flagship');
---

<Base title="Sean Davis — Cancer Data Science">
  <div class="page">
    <Masthead />

    <div class="hero fade">
      <div class="hero-text">
        <h1>Sean Davis</h1>
        <p class="role">Physician-scientist — open software and data for cancer research.</p>
        <ul class="titles">
          <li>MD, PhD · Professor of Medicine and Biomedical Informatics, University of Colorado Anschutz Medical Campus</li>
          <li>Rifkin Bennis Chair of Cancer Informatics</li>
          <li>Associate Director for Informatics and Data Science, University of Colorado Cancer Center</li>
        </ul>
        <p class="lede">
          For almost two decades I've built open tools, curated the public biomedical record, and now
          build AI agents that help researchers find and use it. Core Bioconductor packages I steward
          bridge the field's largest data archives: in 2025, GEOquery alone was downloaded 314,396 times
          from 112,736 distinct IP addresses.
        </p>
        <div class="actions">
          <a href="/files/CV.pdf">CV ({cvDate})</a>
          <a href="https://scholar.google.co.uk/citations?user=hLFc29kAAAAJ">Google Scholar</a>
          <a href="https://orcid.org/0000-0002-8991-6458">ORCID</a>
          <a href="https://github.com/seandavi">GitHub</a>
          <a href="mailto:seandavi@gmail.com">Email</a>
        </div>
      </div>
      <Image class="headshot" src={headshot} alt="Sean Davis" widths={[200, 400]} sizes="200px" loading="eager" />
    </div>

    <section id="work">
      <div class="sec-head">
        <h2>Selected work</h2>
        <div class="note">Community resources, core software, and data infrastructure.</div>
      </div>
      <div class="catalog">
        {featured.map((p) => (
          <article class="entry">
            <div>
              <h3 class="name">{p.data.name}</h3>
              <div class="meta">
                {metaLine(p.data).map((bit, i) => (
                  <>
                    {i > 0 && ' \u00b7 '}
                    <span class={bit === p.data.home ? 'home' : undefined}>{bit}</span>
                  </>
                ))}
              </div>
            </div>
            <p class="desc">
              {p.data.description}{' '}
              <a class="go" href={p.data.url}>{p.data.linkLabel}</a>
              {p.data.paper && (
                <>
                  {' '}
                  <a class="go" href={p.data.paper.url} title={p.data.paper.title}>Paper</a>
                </>
              )}
            </p>
          </article>
        ))}
      </div>
    </section>

    <section id="software">
      <div class="sec-head">
        <h2>More software</h2>
        <div class="note">A few representative tools. <a href="/projects">Browse all projects</a> for the complete directory.</div>
      </div>
      <div class="grid">
        {others.map((p) => (
          <a class="card" href={p.data.url}>
            <h4>
              <span class="n">{p.data.name}</span>
              {p.data.stars !== undefined && <span class="s"> {p.data.stars}★</span>}
            </h4>
            <p>{p.data.description}</p>
          </a>
        ))}
      </div>
    </section>

    <section id="writing">
      <div class="sec-head">
        <h2>Writing</h2>
        <div class="note">Books, manuscripts, and methods.</div>
      </div>
      <div class="writing">
        <div class="wrow">
          <span class="wkind">Book</span>
          <div>
            <p class="wtitle"><a href="https://seandavi.github.io/RBiocBook/">Data Science for Biologists: A Hands-On Introduction with R and Bioconductor</a></p>
            <p>An instructional book grown from ~100 trainees across four course offerings.</p>
          </div>
        </div>
        <div class="wrow">
          <span class="wkind">Book</span>
          <div>
            <p class="wtitle"><a href="https://seandavi.github.io/amc-ai-governance/">Implementing AI at an Academic Medical Center</a></p>
            <p>A working book on AI governance and adoption in academic medicine.</p>
          </div>
        </div>
        <div class="wrow">
          <span class="wkind">Publications</span>
          <div>
            <p class="wtitle"><a href="/publications">Selected publications</a></p>
            <p>Peer-reviewed publications across genomics, informatics, and cancer data science. Full record on <a href={ORCID_URL}>ORCID</a>.</p>
          </div>
        </div>
      </div>
      <p class="notes-slot">
        <a href="/blog">Notes</a> — release notes, build logs, and short technical pieces on the tools,
        data, and methods behind this work.
      </p>
    </section>

    <section id="talks" style="border-bottom: none;">
      <div class="sec-head">
        <h2>Talks &amp; teaching</h2>
        <div class="note">Lectures from the Frontiers of AI in Medicine course and invited talks.</div>
      </div>
      <p class="notes-slot">
        <a href="https://talks.seandavis.net">talks.seandavis.net</a> — the full archive, 2022–present,
        mostly AI/ML in medicine and data science.
      </p>
    </section>

  </div>

  <div class="about" id="about">
    <div class="page">
      <div class="inner">
        <h2>About</h2>
        <p>
          I'm a physician-scientist and Professor of Medicine and Biomedical Informatics at the
          University of Colorado Anschutz Medical Campus, where I hold the Rifkin Bennis Chair of Cancer
          Informatics and am Associate Director for Informatics and Data Science in the Comprehensive
          Cancer Center. I'm board certified in pediatrics and hold an active medical license.
        </p>
        <p class="qual">
          I build open data infrastructure and AI tooling for cancer research, maintain long-standing
          software in the Bioconductor project, and help lead community open-science efforts. Reach me
          through any of the channels below.
        </p>
        <p class="support">
          Current support:{' '}
          {grants.map((g, i) => {
            const role = g.role === 'Co-Investigator' ? 'Co-I' : g.role;
            return (
              <>
                {i > 0 && '; '}
                {g.url ? <a href={g.url}>{g.number}</a> : g.number} ({role})
              </>
            );
          })}
          . <a href="/publications#funding">Details</a>
        </p>
        <div class="links">
          <a href="/bio">Bio &amp; press kit</a>
          <a href="https://github.com/seandavi">GitHub</a>
          <a href="https://scholar.google.co.uk/citations?user=hLFc29kAAAAJ">Google Scholar</a>
          <a href="https://orcid.org/0000-0002-8991-6458">ORCID</a>
          <a href="/files/CV.pdf">CV</a>
          <a href="https://twitter.com/seandavis12">X / @seandavis12</a>
          <a href="mailto:seandavi@gmail.com">Email</a>
        </div>
      </div>
    </div>
  </div>

  <div class="page">
    <footer>
      <div class="colophon">
        <strong style="color:var(--muted);font-weight:600">seandavis.net</strong> — open tools and data for
        cancer research, by Sean Davis.
      </div>
      <div>© 2026 Sean Davis · Built in the open</div>
    </footer>
  </div>
</Base>
