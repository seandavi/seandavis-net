---
import Base from '../layouts/Base.astro';
import { liveProjects, inGroup, metaLine, GROUP_LABELS, type Group } from '../lib/projects';

// Same data the /projects directory renders — the homepage just shows the
// featured subset plus the grouped remainder, so the two can never drift.
const projects = await liveProjects();
const featured = projects.filter((p) => p.data.featured);
const softwareGroups: Group[] = ['ai', 'bioc', 'apps'];
---

<Base title="Sean Davis — Cancer Data Science">
  <div class="page">
    <header class="masthead">
      <a class="mark" href="/">Sean Davis</a>
      <nav>
        <a href="#work">Work</a>
        <a href="/projects">Projects</a>
        <a href="#writing">Writing</a>
        <a href="https://talks.seandavis.net">Talks</a>
        <a href="/blog">Notes</a>
        <a href="#about">About</a>
      </nav>
    </header>

    <div class="hero fade">
      <div class="place">University of Colorado Anschutz Medical Campus</div>
      <h1>Sean Davis</h1>
      <p class="role">Physician-scientist — open software and data for cancer research.</p>
      <p class="lede">
        For over a decade I've built open tools, curated the public biomedical record, and now build
        AI agents that help researchers find and use it. The resources I maintain are used widely across
        genomics, and core Bioconductor packages I steward bridge the field's largest data archives.
      </p>
      <div class="actions">
        <a href="#work">See the work</a>
        <a href="/projects">All projects</a>
        <a href="https://github.com/seandavi">GitHub</a>
        <a href="#about">About &amp; contact</a>
      </div>
    </div>

    <section id="work">
      <div class="sec-head">
        <h2>Selected work</h2>
        <div class="note">Community resources, core software, and data infrastructure.</div>
      </div>
      <div class="catalog">
        {featured.map((p) => (
          <article class="entry">
            <div>
              <h3 class="name">{p.data.name}</h3>
              <div class="meta">
                {metaLine(p.data).map((bit, i) => (
                  <>
                    {i > 0 && ' \u00b7 '}
                    <span class={bit === p.data.home ? 'home' : undefined}>{bit}</span>
                  </>
                ))}
              </div>
            </div>
            <p class="desc">
              {p.data.description}{' '}
              <a class="go" href={p.data.url}>{p.data.linkLabel}</a>
            </p>
          </article>
        ))}
      </div>
    </section>

    <section id="software">
      <div class="sec-head">
        <h2>More software</h2>
        <div class="note">A selection — the full list lives on GitHub.</div>
      </div>

      {softwareGroups.map((group) => (
        <div class="group">
          <h3>{GROUP_LABELS[group]}</h3>
          <div class="grid">
            {inGroup(projects, group).map((p) => (
              <a class="card" href={p.data.url}>
                <h4>
                  {p.data.name}
                  {p.data.stars !== undefined && <span class="s"> {p.data.stars}★</span>}
                </h4>
                <p>{p.data.description}</p>
              </a>
            ))}
          </div>
        </div>
      ))}

      <p class="notes-slot">
        <a href="/projects">Full project directory</a> — every project in one place, with where each
        one is hosted.
      </p>
    </section>

    <section id="writing">
      <div class="sec-head">
        <h2>Writing</h2>
        <div class="note">Books, manuscripts, and methods.</div>
      </div>
      <div class="writing">
        <div class="wrow">
          <span class="wkind">Book</span>
          <div>
            <p class="wtitle"><a href="https://seandavi.github.io/RBiocBook/">Data Science for Biologists: A Hands-On Introduction with R and Bioconductor</a></p>
            <p>An instructional book grown from ~100 trainees across four course offerings.</p>
          </div>
        </div>
        <div class="wrow">
          <span class="wkind">Book</span>
          <div>
            <p class="wtitle"><a href="https://seandavi.github.io/amc-ai-governance/">Implementing AI at an Academic Medical Center</a></p>
            <p>A working book on AI governance and adoption in academic medicine.</p>
          </div>
        </div>
        <div class="wrow">
          <span class="wkind">Publications</span>
          <div>
            <p class="wtitle"><a href="https://orcid.org/0000-0002-8991-6458">Full record on ORCID</a></p>
            <p>Peer-reviewed publications across genomics, informatics, and cancer data science.</p>
          </div>
        </div>
      </div>
      <p class="notes-slot">
        <a href="/blog">Notes</a> — release notes, build logs, and short technical pieces on the tools,
        data, and methods behind this work.
      </p>
    </section>

    <section id="talks">
      <div class="sec-head">
        <h2>Talks &amp; teaching</h2>
        <div class="note">Lectures from the Frontiers of AI in Medicine course and invited talks.</div>
      </div>
      <p class="notes-slot">
        <a href="https://talks.seandavis.net">talks.seandavis.net</a> — the full archive, 2022–present,
        mostly AI/ML in medicine and data science.
      </p>
    </section>

    <section id="cdsci" style="border-bottom: none;">
      <div class="band">
        <p>
          Much of the data-infrastructure work above lives under an open program,{' '}
          <strong style="font-weight:600;color:var(--ink)">Cancer Data Science</strong> — OmicIDX,
          CFDE Atlas, curated datasets, and more.
        </p>
        <a href="https://cancerdatasci.org">cancerdatasci.org</a>
      </div>
    </section>
  </div>

  <div class="about" id="about">
    <div class="page">
      <div class="inner">
        <h2>About</h2>
        <p>
          I'm a physician-scientist and Professor of Medicine at the University of Colorado Anschutz
          Medical Campus, where I'm Associate Director for Informatics and Data Science in the
          Comprehensive Cancer Center and Deputy Director of the Center for Health AI.
        </p>
        <p class="qual">
          I build open data infrastructure and AI tooling for cancer research, maintain long-standing
          software in the Bioconductor project, and help lead community open-science efforts. Reach me
          through any of the channels below.
        </p>
        <div class="links">
          <a href="https://github.com/seandavi">GitHub</a>
          <a href="https://scholar.google.co.uk/citations?user=hLFc29kAAAAJ">Google Scholar</a>
          <a href="https://orcid.org/0000-0002-8991-6458">ORCID</a>
          <a href="/files/CV.pdf">CV</a>
          <a href="https://twitter.com/seandavis12">X / @seandavis12</a>
          <a href="mailto:seandavi@gmail.com">Email</a>
        </div>
      </div>
    </div>
  </div>

  <div class="page">
    <footer>
      <div class="colophon">
        <strong style="color:var(--muted);font-weight:600">seandavis.net</strong> — open tools and data for
        cancer research, by Sean Davis. Data-infrastructure work lives at{' '}
        <a href="https://cancerdatasci.org">cancerdatasci.org</a>.
      </div>
      <div>© 2026 Sean Davis · Built in the open</div>
    </footer>
  </div>
</Base>
