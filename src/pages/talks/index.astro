---
import Base from '../../layouts/Base.astro';
import talks from '../../data/talks.json';

const sorted = [...talks].sort((a, b) => (a.date < b.date ? 1 : -1));
---

<Base title="Talks & teaching — Sean Davis" description="Talks and teaching by Sean Davis, mostly on AI/ML in medicine and data science.">
  <div class="page">
    <header class="masthead">
      <a class="mark" href="/">Sean Davis</a>
      <nav>
        <a href="/#work">Work</a>
        <a href="/#software">Software</a>
        <a href="/#writing">Writing</a>
        <a href="/talks">Talks</a>
        <a href="/blog">Notes</a>
        <a href="/#about">About</a>
      </nav>
    </header>

    <section style="border-bottom: none;">
      <div class="sec-head">
        <h2>Talks &amp; teaching</h2>
        <div class="note">
          A 2022–2025 archive, mostly AI/ML in medicine and data science. Slides open in a new page;
          the full source lives in the <a href="https://seandavi.github.io/talks/">talks site</a>.
        </div>
      </div>
      <div class="writing">
        {sorted.map((t) => (
          <div class="wrow">
            <span class="wkind">{t.dateLabel}</span>
            <div>
              <p class="wtitle"><a href={t.url}>{t.title}</a></p>
              <p>{t.venue} — {t.description}</p>
            </div>
          </div>
        ))}
      </div>
      <p class="back" style="margin-top:2rem;"><a href="/">← Back to home</a></p>
    </section>
  </div>
</Base>
