---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Masthead from '../components/Masthead.astro';
import headshot from '../assets/sean-davis.jpg';
import { cvDate } from '../lib/cv';

// Facts from the public CV (public/files/CV.pdf) and Sean. Emphasis follows how hosts introduce
// him: education, breadth of research, Bioconductor leadership, infrastructure that enables
// other scientists, and teaching. Keep tool-level detail out; /projects has it.
const shortBio =
  'Sean Davis, MD, PhD, is Professor of Medicine and Biomedical Informatics and Rifkin Bennis Chair of Cancer Informatics at the University of Colorado Anschutz Medical Campus, and Associate Director for Informatics and Data Science at the University of Colorado Cancer Center. Trained in engineering, human genetics, and pediatric oncology, he has spent almost two decades building open software and data infrastructure for biomedical research, has held leadership roles in the Bioconductor project since 2008, and teaches data science and AI in medicine.';

const longBio = [
  'Sean Davis, MD, PhD, is Professor of Medicine and Biomedical Informatics at the University of Colorado Anschutz Medical Campus, where he holds the Rifkin Bennis Chair of Cancer Informatics and is Associate Director for Informatics and Data Science at the University of Colorado Cancer Center. He studied mechanical and aerospace engineering at Princeton University and earned his MD and a PhD in human genetics at the University of Pittsburgh. He trained in pediatrics at the University of Washington and in pediatric hematology/oncology in the combined Johns Hopkins and National Cancer Institute fellowship, and is board certified in pediatrics. From 2005 to 2020 he was at the National Institutes of Health, at the National Human Genome Research Institute and then the National Cancer Institute\u2019s Center for Cancer Research.',
  'His research has ranged across pediatric cancer genomics, gene regulation, the human microbiome, and the design and evaluation of biomedical data ecosystems, and more recently the adoption of AI in academic medicine. A common thread is building the shared infrastructure that lets other scientists use public data: open-source software downloaded by more than 50,000 users a year, work on NIH\u2019s Biowulf and CU Anschutz\u2019s Alpine research computing environments, and national efforts including the NCI Cancer Cloud Pilots, the NHGRI AnVIL project, and the NIH Common Fund Data Ecosystem.',
  'He has held leadership roles in the Bioconductor project since 2008. He served on its Technical Advisory Board from 2008 to 2020, organized or co-organized its annual conference from 2008 to 2021, edits the F1000Research Bioconductor channel, and in 2026 led the move of bioconductor.org to new web infrastructure.',
  'He has taught for more than twenty years. Since 2013 he has been a senior instructor and organizer of the Statistical Methods for Functional Genomics course at Cold Spring Harbor Laboratory, and he directs Frontiers of AI in Medicine, a course for medical students at CU Anschutz. He is the author of the open textbook Data Science for Biologists.',
];
---

<Base
  title="Bio & press kit — Sean Davis"
  description="Short and long bios, a headshot, talks, and contact details for Sean Davis, MD, PhD."
>
  <div class="page">
    <Masthead only={['projects', 'writing', 'talks', 'notes', 'about']} />

    <article class="prose bio">
      <h1>Bio &amp; press kit</h1>
      <p class="post-date">For event hosts, editors, and collaborators.</p>

      <figure class="bio-photo">
        <Image src={headshot} alt="Sean Davis" widths={[300, 600]} sizes="300px" loading="eager" />
        <figcaption>
          <a href="/files/sean-davis-headshot.jpg" download>Download headshot (JPEG, {headshot.width} × {headshot.height})</a>
        </figcaption>
      </figure>

      <h2>Short bio</h2>
      <blockquote class="bio-copy">
        <p>{shortBio}</p>
      </blockquote>

      <h2>Long bio</h2>
      <blockquote class="bio-copy">
        {longBio.map((p) => <p>{p}</p>)}
      </blockquote>

      <h2>Talks</h2>
      <p>
        Slides and materials from recent talks are at{' '}
        <a href="https://talks.seandavis.net">talks.seandavis.net</a>, and the{' '}
        <a href="/files/CV.pdf">CV</a> lists selected invited presentations. If you have a topic in
        mind, include it in your invitation.
      </p>

      <h2>Contact</h2>
      <p>
        For speaking invitations and collaboration, email{' '}
        <a href="mailto:seandavi@gmail.com">seandavi@gmail.com</a>.
      </p>
      <p class="bio-links">
        <a href="/files/CV.pdf">CV (PDF, {cvDate})</a>
        <a href="https://scholar.google.co.uk/citations?user=hLFc29kAAAAJ">Google Scholar</a>
        <a href="https://orcid.org/0000-0002-8991-6458">ORCID</a>
        <a href="https://github.com/seandavi">GitHub</a>
      </p>

      <p class="back"><a href="/">← Back to home</a></p>
    </article>
  </div>
</Base>
