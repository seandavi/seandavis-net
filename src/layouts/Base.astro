---
import { getImage } from 'astro:assets';
// Self-hosted Source Serif 4 (SIL OFL), optical-size axis, upright + italic.
import '@fontsource-variable/source-serif-4/opsz.css';
import '@fontsource-variable/source-serif-4/opsz-italic.css';
import '../styles/global.css';
import 'katex/dist/katex.min.css';
import headshot from '../assets/sean-davis.png';

interface Props {
  title?: string;
  description?: string;
}
const {
  title = 'Sean Davis',
  description = 'Sean Davis — open software and data for cancer research.',
} = Astro.props;

// Link previews (Slack, LinkedIn, Mastodon) need an absolute URL to a JPEG/PNG.
const ogImage = await getImage({ src: headshot, format: 'jpg' });
const ogImageUrl = new URL(ogImage.src, Astro.site).href;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:alt" content="Sean Davis" />
    <meta name="twitter:card" content="summary" />
    <!-- GA4 per monode infrastructure/ANALYTICS.md: one property, hard-coded public ID,
         content_group = site key. Allow-listed to the production host so localhost,
         workers.dev previews, and tailnet hosts never load or report. -->
    <script is:inline>
      if (location.hostname === 'seandavis.net') {
        const s = document.createElement('script');
        s.async = true;
        s.src = 'https://www.googletagmanager.com/gtag/js?id=G-KLLV1GCF4E';
        document.head.appendChild(s);
        window.dataLayer = window.dataLayer || [];
        window.gtag = function () { dataLayer.push(arguments); };
        gtag('js', new Date());
        gtag('config', 'G-KLLV1GCF4E', { content_group: 'seandavis-net' });
      }
    </script>
    <link rel="alternate" type="application/rss+xml" title="Sean Davis — Notes" href="/rss.xml" />
    <!-- Per-page head tags, e.g. <Fragment slot="head"><meta … /></Fragment>. -->
    <slot name="head" />
  </head>
  <body>
    <slot />
  </body>
</html>
