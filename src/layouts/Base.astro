---
import { getImage } from 'astro:assets';
// Self-hosted Source Serif 4 (SIL OFL), optical-size axis, upright + italic.
import '@fontsource-variable/source-serif-4/opsz.css';
import '@fontsource-variable/source-serif-4/opsz-italic.css';
import '../styles/global.css';
import 'katex/dist/katex.min.css';
// 1200×630 landscape crop of the headshot session, the size link previews expect.
import ogPhoto from '../assets/sean-davis-og.jpg';

interface Props {
  title?: string;
  description?: string;
}
const {
  title = 'Sean Davis',
  description = 'Sean Davis — open software and data for cancer research.',
} = Astro.props;

// Link previews (Slack, LinkedIn, Mastodon) need an absolute URL to a JPEG/PNG.
const ogImage = await getImage({ src: ogPhoto, format: 'jpg' });
const ogImageUrl = new URL(ogImage.src, Astro.site).href;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content={String(ogPhoto.width)} />
    <meta property="og:image:height" content={String(ogPhoto.height)} />
    <meta property="og:image:alt" content="Sean Davis" />
    <meta name="twitter:card" content="summary_large_image" />
    <!-- GA4 per monode infrastructure/ANALYTICS.md: one property, hard-coded public ID,
         content_group = site key. Allow-listed to the production host so localhost,
         workers.dev previews, and tailnet hosts never load or report. -->
    <script is:inline>
      if (location.hostname === 'seandavis.net') {
        const s = document.createElement('script');
        s.async = true;
        s.src = 'https://www.googletagmanager.com/gtag/js?id=G-KLLV1GCF4E';
        document.head.appendChild(s);
        window.dataLayer = window.dataLayer || [];
        window.gtag = function () { dataLayer.push(arguments); };
        gtag('js', new Date());
        gtag('config', 'G-KLLV1GCF4E', { content_group: 'seandavis-net' });
      }
    </script>
    <link rel="alternate" type="application/rss+xml" title="Sean Davis — Notes" href="/rss.xml" />
    <!-- Per-page head tags, e.g. <Fragment slot="head"><meta … /></Fragment>. -->
    <slot name="head" />
  </head>
  <body>
    <slot />
    <dialog id="lightbox" aria-label="Enlarged image">
      <img id="lightbox-img" alt="" />
    </dialog>
    <script>
      // Click any image inside post prose to see it full-size; click the
      // backdrop, the image, or Escape to close.
      const dialog = document.getElementById('lightbox') as HTMLDialogElement | null;
      const img = document.getElementById('lightbox-img') as HTMLImageElement | null;
      document.addEventListener('click', (event) => {
        const target = event.target;
        if (target instanceof HTMLImageElement && target.closest('.prose') && dialog && img) {
          img.src = target.currentSrc || target.src;
          img.alt = target.alt;
          dialog.showModal();
        }
      });
      dialog?.addEventListener('click', (event) => {
        if (event.target === dialog || event.target === img) dialog.close();
      });
    </script>
  </body>
</html>
